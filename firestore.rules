rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust security & ABAC validation
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128 && docId.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('e2eeSalt' in data) || (data.e2eeSalt is string && data.e2eeSalt.size() <= 256))
        && (!('e2eeVerificationHash' in data) || (data.e2eeVerificationHash is string && data.e2eeVerificationHash.size() <= 512))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for MonthlyRecord (Zero-Knowledge Ciphertext)
    function isValidMonthlyRecord(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && data.monthYear is string
        && data.monthYear.size() >= 5
        && data.monthYear.size() <= 12
        && data.encryptedPayload is string
        && data.encryptedPayload.size() > 0
        && data.encryptedPayload.size() <= 200000
        && data.iv is string
        && data.iv.size() >= 12
        && data.iv.size() <= 128;
    }

    // User root document - absolute isolation per account
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow listing of users collection globally
      allow create: if isOwner(userId) 
                    && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) 
                    && isValidUserProfile(request.resource.data, userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);

      // Monthly Encrypted Records Subcollection
      match /records/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && isValidId(recordId)
                      && isValidMonthlyRecord(request.resource.data, userId);
        allow update: if isOwner(userId) 
                      && isValidId(recordId)
                      && isValidMonthlyRecord(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // Security Audit Subcollection
      match /auditLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) 
                      && isValidId(logId)
                      && request.resource.data.userId == userId
                      && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false; // Audit trail is append-only
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
